# Nightly sales load: dimensions first, then facts.
kind: loom
config_version: "2.0"

weaves:
  - ref: dims.weave
  - ref: facts.weave
    condition:
      when: "table_exists('raw.orders')"
  - ref: weaves/returns.weave
  - name: audit
    config_version: "2.0"
    threads:
      - name: audit_log
        config_version: "2.0"
        sources:
          log:
            type: delta
            alias: raw.audit_log
        target:
          alias: ops.audit_log
