{
  "config_name": "fact_transactions",
  "config_type": "thread",
  "model": {
    "config_version": "2.0",
    "load": {
      "mode": "incremental_watermark",
      "watermark_column": "transaction_ts",
      "watermark_type": "timestamp"
    },
    "name": "fact_transactions",
    "qualified_key": "fact_transactions.thread",
    "sources": {
      "transactions": {
        "alias": "raw.transactions",
        "type": "delta"
      }
    },
    "steps": [
      {
        "filter": {
          "expr": "amount > 0"
        }
      },
      {
        "derive": {
          "columns": {
            "transaction_date": "to_date(transaction_ts)"
          }
        }
      },
      {
        "select": {
          "columns": [
            "transaction_id",
            "account_id",
            "amount",
            "currency",
            "transaction_ts",
            "transaction_date"
          ]
        }
      }
    ],
    "target": {
      "alias": "curated.fact_transactions",
      "partition_by": [
        "transaction_date"
      ]
    },
    "write": {
      "match_keys": [
        "transaction_id"
      ],
      "mode": "merge"
    }
  },
  "threads": {},
  "weaves": {}
}
