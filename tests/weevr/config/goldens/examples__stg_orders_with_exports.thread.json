{
  "config_name": "stg_orders_with_exports",
  "config_type": "thread",
  "model": {
    "config_version": "2.0",
    "exports": [
      {
        "description": "Daily Parquet archive for external consumers",
        "name": "parquet_archive",
        "partition_by": [
          "order_year"
        ],
        "path": "/lakehouse/archive/orders/${run.timestamp}/",
        "type": "parquet"
      },
      {
        "description": "Pipe-delimited CSV for legacy system",
        "name": "csv_extract",
        "options": {
          "delimiter": "|",
          "header": "true"
        },
        "path": "/lakehouse/exports/orders_latest/",
        "type": "csv"
      }
    ],
    "name": "stg_orders_with_exports",
    "qualified_key": "stg_orders_with_exports.thread",
    "sources": {
      "orders": {
        "alias": "bronze.orders",
        "type": "delta"
      }
    },
    "steps": [
      {
        "filter": {
          "expr": "status != 'cancelled'"
        }
      },
      {
        "derive": {
          "columns": {
            "order_year": "year(order_date)"
          }
        }
      }
    ],
    "target": {
      "alias": "silver.stg_orders"
    },
    "write": {}
  },
  "threads": {},
  "weaves": {}
}
