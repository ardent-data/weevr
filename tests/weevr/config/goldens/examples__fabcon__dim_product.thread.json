{
  "config_name": "dim_product",
  "config_type": "thread",
  "model": {
    "config_version": "2.0",
    "keys": {
      "business_key": [
        "product_id"
      ],
      "surrogate_key": {
        "algorithm": "xxhash64",
        "name": "product_sk"
      }
    },
    "name": "dim_product",
    "qualified_key": "dim_product.thread",
    "sources": {
      "products": {
        "alias": "staging.products",
        "type": "delta"
      }
    },
    "steps": [
      {
        "select": {
          "columns": [
            "product_id",
            "product_name",
            "category",
            "unit_price",
            "supplier"
          ]
        }
      },
      {
        "cast": {
          "columns": {
            "unit_price": "decimal(10,2)"
          }
        }
      }
    ],
    "target": {
      "alias": "silver.dim_product"
    },
    "write": {
      "match_keys": [
        "product_id"
      ],
      "mode": "merge",
      "on_no_match_source": "soft_delete",
      "soft_delete_column": "is_deleted"
    }
  },
  "threads": {},
  "weaves": {}
}
