{
  "config_name": "dim_contacts",
  "config_type": "thread",
  "model": {
    "config_version": "2.0",
    "name": "dim_contacts",
    "qualified_key": "dim_contacts.thread",
    "sources": {
      "raw_contacts": {
        "alias": "raw_contacts",
        "type": "delta"
      }
    },
    "steps": [
      {
        "concat": {
          "columns": [
            "first_name",
            "middle_name",
            "last_name"
          ],
          "separator": " ",
          "target": "full_name",
          "trim": true
        }
      },
      {
        "map": {
          "column": "status_code",
          "default": "Unknown",
          "target": "status_label",
          "values": {
            "A": "Active",
            "I": "Inactive",
            "P": "Pending"
          }
        }
      },
      {
        "fill_null": {
          "code": "unknown",
          "exclude": [
            "id",
            "*_id"
          ],
          "mode": "type_defaults",
          "overrides": {
            "region": "Unspecified"
          }
        }
      },
      {
        "format": {
          "columns": {
            "hire_date": {
              "date": "yyyy-MM-dd"
            },
            "phone_display": {
              "pattern": "({1:3}) {4:3}-{7:4}",
              "source": "phone_raw"
            }
          }
        }
      }
    ],
    "target": {
      "alias": "dim_contacts"
    }
  },
  "threads": {},
  "weaves": {}
}
