{
  "config_name": "dim_product",
  "config_type": "thread",
  "model": {
    "config_version": "2.0",
    "keys": {
      "business_key": [
        "product_id"
      ]
    },
    "name": "dim_product",
    "qualified_key": "dim_product.thread",
    "sources": {
      "products": {
        "alias": "staging.products",
        "type": "delta"
      }
    },
    "steps": [
      {
        "select": {
          "columns": [
            "product_id",
            "product_name",
            "category",
            "unit_price",
            "is_active",
            "updated_at"
          ]
        }
      },
      {
        "cast": {
          "columns": {
            "unit_price": "decimal(12,2)"
          }
        }
      }
    ],
    "target": {
      "alias": "curated.dim_product"
    },
    "write": {
      "match_keys": [
        "product_id"
      ],
      "mode": "merge"
    }
  },
  "threads": {},
  "weaves": {}
}
