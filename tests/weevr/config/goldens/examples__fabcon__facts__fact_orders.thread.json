{
  "config_name": "fact_orders",
  "config_type": "thread",
  "model": {
    "config_version": "2.0",
    "name": "fact_orders",
    "qualified_key": "facts/fact_orders.thread",
    "sources": {
      "dim_customer": {
        "lookup": "dim_customer"
      },
      "dim_product": {
        "lookup": "dim_product"
      },
      "orders": {
        "alias": "raw.orders",
        "type": "delta"
      }
    },
    "steps": [
      {
        "join": {
          "on": [
            {
              "left": "customer_id",
              "right": "customer_id"
            }
          ],
          "source": "dim_customer",
          "type": "left"
        }
      },
      {
        "join": {
          "on": [
            {
              "left": "product_id",
              "right": "product_id"
            }
          ],
          "source": "dim_product",
          "type": "left"
        }
      },
      {
        "derive": {
          "columns": {
            "order_total": "quantity * unit_price"
          }
        }
      },
      {
        "select": {
          "columns": [
            "order_id",
            "order_date",
            "customer_id",
            "customer_sk",
            "product_id",
            "product_sk",
            "quantity",
            "unit_price",
            "order_total"
          ]
        }
      },
      {
        "cast": {
          "columns": {
            "order_total": "decimal(12,2)",
            "unit_price": "decimal(10,2)"
          }
        }
      }
    ],
    "target": {
      "alias": "silver.fact_orders",
      "partition_by": [
        "order_date"
      ]
    },
    "write": {}
  },
  "threads": {},
  "weaves": {}
}
