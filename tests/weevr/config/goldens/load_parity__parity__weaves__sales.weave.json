{
  "config_name": "sales",
  "config_type": "weave",
  "model": {
    "config_version": "2.0",
    "defaults": {
      "write": {
        "mode": "append"
      }
    },
    "name": "sales",
    "qualified_key": "weaves/sales.weave",
    "threads": [
      {
        "ref": "threads/stg_orders.thread"
      },
      {
        "as_": "orders_east",
        "params": {
          "region": "east"
        },
        "ref": "threads/regional.thread"
      },
      {
        "as_": "orders_west",
        "dependencies": [
          "stg_orders"
        ],
        "params": {
          "region": "west"
        },
        "ref": "threads/regional.thread"
      }
    ]
  },
  "threads": {
    "sales": {
      "orders_east": {
        "config_version": "2.0",
        "name": "orders_east",
        "params": {
          "region": {
            "name": "region",
            "type": "string"
          }
        },
        "qualified_key": "threads/regional.thread",
        "sources": {
          "orders": {
            "alias": "stg.orders",
            "type": "delta"
          }
        },
        "steps": [
          {
            "filter": {
              "expr": "region = 'east'"
            }
          }
        ],
        "target": {
          "alias": "gold.orders_east"
        },
        "template_ref": "threads/regional.thread",
        "write": {
          "mode": "append"
        }
      },
      "orders_west": {
        "config_version": "2.0",
        "name": "orders_west",
        "params": {
          "region": {
            "name": "region",
            "type": "string"
          }
        },
        "qualified_key": "threads/regional.thread",
        "sources": {
          "orders": {
            "alias": "stg.orders",
            "type": "delta"
          }
        },
        "steps": [
          {
            "filter": {
              "expr": "region = 'west'"
            }
          }
        ],
        "target": {
          "alias": "gold.orders_west"
        },
        "template_ref": "threads/regional.thread",
        "write": {
          "mode": "append"
        }
      },
      "stg_orders": {
        "config_version": "2.0",
        "execution": {
          "log_level": "minimal"
        },
        "name": "stg_orders",
        "qualified_key": "threads/stg_orders.thread",
        "sources": {
          "orders": {
            "options": {
              "header": true
            },
            "path": "<root>/data/orders.csv",
            "type": "csv"
          }
        },
        "steps": [
          {
            "filter": {
              "expr": "order_id is not null"
            }
          },
          {
            "filter": {
              "expr": "customer_id is not null"
            }
          }
        ],
        "target": {
          "alias": "stg.orders"
        },
        "template_ref": "threads/stg_orders.thread",
        "write": {
          "mode": "append"
        }
      }
    }
  },
  "weaves": {}
}
