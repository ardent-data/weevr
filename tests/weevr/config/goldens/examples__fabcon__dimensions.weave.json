{
  "config_name": "dimensions",
  "config_type": "weave",
  "model": {
    "config_version": "2.0",
    "name": "dimensions",
    "qualified_key": "dimensions.weave",
    "threads": [
      {
        "name": "stg_customers",
        "ref": "dimensions/stg_customers.thread"
      },
      {
        "name": "stg_products",
        "ref": "dimensions/stg_products.thread"
      },
      {
        "dependencies": [
          "stg_customers"
        ],
        "name": "dim_customer",
        "ref": "dimensions/dim_customer.thread"
      },
      {
        "dependencies": [
          "stg_products"
        ],
        "name": "dim_product",
        "ref": "dimensions/dim_product.thread"
      }
    ]
  },
  "threads": {
    "dimensions": {
      "dim_customer": {
        "config_version": "2.0",
        "keys": {
          "business_key": [
            "customer_id"
          ],
          "change_detection": {
            "algorithm": "xxhash64",
            "columns": [
              "first_name",
              "last_name",
              "full_name",
              "email"
            ],
            "name": "row_hash"
          },
          "surrogate_key": {
            "algorithm": "xxhash64",
            "name": "customer_sk"
          }
        },
        "name": "dim_customer",
        "qualified_key": "dimensions/dim_customer.thread",
        "sources": {
          "customers": {
            "alias": "staging.stg_customers",
            "type": "delta"
          }
        },
        "steps": [
          {
            "select": {
              "columns": [
                "customer_id",
                "first_name",
                "last_name",
                "full_name",
                "email",
                "signup_date"
              ]
            }
          }
        ],
        "target": {
          "alias": "silver.dim_customer"
        },
        "template_ref": "dimensions/dim_customer.thread",
        "write": {
          "match_keys": [
            "customer_id"
          ],
          "mode": "merge"
        }
      },
      "dim_product": {
        "config_version": "2.0",
        "keys": {
          "business_key": [
            "product_id"
          ],
          "surrogate_key": {
            "algorithm": "xxhash64",
            "name": "product_sk"
          }
        },
        "name": "dim_product",
        "qualified_key": "dimensions/dim_product.thread",
        "sources": {
          "products": {
            "alias": "staging.stg_products",
            "type": "delta"
          }
        },
        "steps": [
          {
            "select": {
              "columns": [
                "product_id",
                "product_name",
                "category",
                "unit_price",
                "supplier"
              ]
            }
          }
        ],
        "target": {
          "alias": "silver.dim_product"
        },
        "template_ref": "dimensions/dim_product.thread",
        "write": {
          "match_keys": [
            "product_id"
          ],
          "mode": "merge"
        }
      },
      "stg_customers": {
        "config_version": "2.0",
        "name": "stg_customers",
        "qualified_key": "dimensions/stg_customers.thread",
        "sources": {
          "customers": {
            "options": {
              "header": true,
              "inferSchema": true
            },
            "path": "<root>/data/customers.csv",
            "type": "csv"
          }
        },
        "steps": [
          {
            "filter": {
              "expr": "status = 'active'"
            }
          },
          {
            "dedup": {
              "keys": [
                "customer_id"
              ],
              "order_by": "signup_date DESC"
            }
          },
          {
            "derive": {
              "columns": {
                "full_name": "concat(first_name, ' ', last_name)"
              }
            }
          },
          {
            "select": {
              "columns": [
                "customer_id",
                "first_name",
                "last_name",
                "full_name",
                "email",
                "signup_date"
              ]
            }
          },
          {
            "cast": {
              "columns": {
                "customer_id": "int",
                "signup_date": "date"
              }
            }
          }
        ],
        "target": {
          "alias": "staging.stg_customers"
        },
        "template_ref": "dimensions/stg_customers.thread",
        "write": {}
      },
      "stg_products": {
        "config_version": "2.0",
        "name": "stg_products",
        "qualified_key": "dimensions/stg_products.thread",
        "sources": {
          "products": {
            "alias": "raw.products",
            "type": "delta"
          }
        },
        "steps": [
          {
            "select": {
              "columns": [
                "product_id",
                "product_name",
                "category",
                "unit_price",
                "supplier"
              ]
            }
          },
          {
            "cast": {
              "columns": {
                "unit_price": "decimal(10,2)"
              }
            }
          }
        ],
        "target": {
          "alias": "staging.stg_products"
        },
        "template_ref": "dimensions/stg_products.thread",
        "write": {}
      }
    }
  },
  "weaves": {}
}
