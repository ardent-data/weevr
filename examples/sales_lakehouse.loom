# Full Loom Example
#
# A deployment unit that groups two weaves with shared defaults,
# parameters, and execution settings. Configuration cascades from
# loom defaults down to individual threads.

config_version: "1.0"
name: sales_lakehouse

# The weaves (and their threads) are defined inline so the example is
# self-contained; in a project they would usually live in their own .weave and
# .thread files and be listed with `ref:`.
weaves:
  - name: dimensions
    config_version: "1.0"
    threads:
      - name: dim_customer
        config_version: "1.0"
        sources:
          customers:
            type: delta
            alias: staging.customers
        target:
          path: "${param.lakehouse_path}/curated/dim_customer"

  - name: facts
    condition:
      when: "table_exists('curated.dim_customer')"
    config_version: "1.0"
    threads:
      - name: fact_orders
        config_version: "1.0"
        sources:
          orders:
            type: delta
            alias: staging.orders
        steps:
          - filter:
              expr: "order_date >= '${param.load_date}'"
        target:
          path: "${param.lakehouse_path}/curated/fact_orders"

# Shared defaults inherited by all weaves and threads
defaults:
  write:
    mode: overwrite
  execution:
    log_level: standard

# Parameters injected into thread configs via ${param.x} syntax
params:
  lakehouse_path:
    name: lakehouse_path
    type: string
    required: true
    description: "Root path for the lakehouse storage layer"
  load_date:
    name: load_date
    type: date
    required: false
    default: "2025-01-01"
    description: "Date to use for incremental load boundaries"

execution:
  log_level: standard
  trace: true
