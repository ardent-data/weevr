# Warp auto-generation — with `warp_mode: auto` and `schema_drift: adaptive`,
# the engine writes and evolves a .warp schema contract from the thread output.

config_version: "1.0"
name: warp-auto

sources:
  orders:
    type: delta
    alias: bronze.raw_orders

steps:
  - select:
      columns:
        - order_id
        - customer_id
        - amount
        - order_date

target:
  alias: gold.fact_orders
  warp_mode: auto
  schema_drift: adaptive
